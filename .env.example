# Copy to .env ON THE SERVER and fill in there. Never paste these values into chat, git or a ticket.
# On Windows the file is C:\ecom\app\.env, readable by Administrators and SYSTEM only (install.ps1 sets this).

# --- Database (PostgreSQL on localhost only) ---
DATABASE_URL=postgres://ecom:CHANGE_ME@localhost:5432/ecom
DB_POOL_MAX=5

# --- Encryption keys: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe OFF the server: without them, stored credentials and backups cannot be decrypted.
APP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# --- Backups: a folder that is NOT on the VPS disk (mapped drive, or a folder synced by rclone) ---
BACKUP_DIR=C:\ecom\backups
BACKUP_RETENTION_DAYS=30
# Folder with pg_dump.exe / pg_restore.exe if they are not on PATH
PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin

# --- App ---
HISTORY_MONTHS=24
BUSINESS_TZ=Europe/Sofia
MAX_USERS=2
MEDIA_DIR=C:\ecom\media

# --- Shopify: one block per store. List the keys you use in SHOPIFY_STORES. ---
# Used by `pnpm phase0` (connection test) and `pnpm --filter @ecom/worker cli import-env`
# (which stores them encrypted in the database). Stores can also be added in Settings.
SHOPIFY_STORES=US,BG
SHOPIFY_US_DOMAIN=your-us-store.myshopify.com
SHOPIFY_US_CLIENT_ID=
SHOPIFY_US_CLIENT_SECRET=
SHOPIFY_US_REGION=us
SHOPIFY_US_REGION_NAME=US
SHOPIFY_BG_DOMAIN=your-bg-store.myshopify.com
SHOPIFY_BG_CLIENT_ID=
SHOPIFY_BG_CLIENT_SECRET=
SHOPIFY_BG_REGION=bg
SHOPIFY_BG_REGION_NAME=Bulgaria

# --- Meta: System User token with ads_read, assigned to both ad accounts ---
META_SYSTEM_USER_TOKEN=
